<Window x:Class="Flockbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flockbot"
        Width="500"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="2,20,0,8" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <StackPanel Margin="24,12,24,16">
    <Image Source="flockbot.png" Width="80" Height="80" RenderOptions.BitmapScalingMode="HighQuality" />
    <TextBlock Text="Flockbot" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,2" />
    <TextBlock Text="Connect your parish Flocknote to Claude and ChatGPT." Style="{StaticResource Secondary}"
               HorizontalAlignment="Center" TextAlignment="Center" />

    <TextBlock Text="Flocknote" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="Checking" Text="Checking sign-in…" Style="{StaticResource Secondary}" />

        <Grid x:Name="SignedInPanel" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="&#xEC61;" FontSize="22" Style="{StaticResource Glyph}"
                     Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
          <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
            <TextBlock Text="Signed in" />
            <TextBlock x:Name="ParishAddress" Style="{StaticResource Secondary}" />
          </StackPanel>
          <Button x:Name="SignOutButton" Grid.Column="2" Content="Sign Out…" Click="SignOut_Click" />
        </Grid>

        <Grid x:Name="SignInForm" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Label Content="Parish" Target="{Binding ElementName=Parish}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Parish" TextChanged="Field_Changed" AutomationProperties.Name="Parish" />
            <TextBlock Grid.Column="1" Text=".flocknote.com" Style="{StaticResource Secondary}"
                       VerticalAlignment="Center" Margin="6,0,0,0" />
          </Grid>
          <Label Grid.Row="1" Content="Email" Target="{Binding ElementName=Email}" VerticalAlignment="Center" Margin="0,8,12,0" />
          <TextBox x:Name="Email" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" TextChanged="Field_Changed"
                   AutomationProperties.Name="Email" />
          <Label Grid.Row="2" Content="Password" Target="{Binding ElementName=Password}" VerticalAlignment="Center" Margin="0,8,12,0" />
          <PasswordBox x:Name="Password" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" PasswordChanged="Field_Changed"
                       AutomationProperties.Name="Password" />
          <TextBlock x:Name="SignInMessage" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,10,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
          <DockPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="SignInButton" DockPanel.Dock="Right" Content="Sign In" IsDefault="True" MinWidth="96"
                    Style="{DynamicResource AccentButtonStyle}" Click="SignIn_Click" />
            <TextBlock x:Name="SigningIn" DockPanel.Dock="Right" Text="Signing in…" Style="{StaticResource Secondary}"
                       VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
          </DockPanel>
        </Grid>

        <TextBlock x:Name="SignedInHint" Margin="0,10,0,0" Style="{StaticResource Secondary}" Visibility="Collapsed"
                   Text="If Claude or ChatGPT sent you here, go back to your chat to continue." />
        <TextBlock x:Name="SignOutMessage" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
      </StackPanel>
    </Border>
    <StackPanel x:Name="PasswordNote" Orientation="Horizontal" Margin="2,8,0,0" Visibility="Collapsed">
      <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock Text="Your password is sent only to Flocknote and is never saved." Style="{StaticResource Secondary}"
                 Margin="6,0,0,0" />
    </StackPanel>

    <TextBlock Text="Assistants" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}" Padding="16,4">
      <StackPanel x:Name="AssistantRows" />
    </Border>
    <TextBlock x:Name="AssistantsFooter" Style="{StaticResource Secondary}" HorizontalAlignment="Center"
               TextAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" />

    <TextBlock Text="Flockbot is independent and not affiliated with Flocknote." FontSize="12" HorizontalAlignment="Center"
               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,20,0,0" />
    <TextBlock x:Name="VersionLabel" FontSize="12" HorizontalAlignment="Center"
               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0" />
  </StackPanel>
</Window>
