<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Bun's JavaScriptCore compiles code at run time. Without this, the
       hardened runtime that notarization requires silently disables the JIT
       and the connector runs about nine times slower. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
