{
  "name": "@askmyparish/flockbot",
  "version": "0.0.0",
  "private": true,
  "description": "A portable Flocknote integration client",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p adapters/zapier/tsconfig.json",
    "test": "vitest run",
    "build": "tsc && npm run build:zapier",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "test:package": "node scripts/check-package.mjs && node scripts/check-zapier-package.mjs",
    "build:zapier": "node scripts/build-zapier.mjs"
  },
  "dependencies": {
    "parse5": "7.3.0",
    "tough-cookie": "6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "undici": "7.30.1",
    "vitest": "5.0.5",
    "esbuild": "0.28.2",
    "@types/node-fetch": "2.6.13"
  },
  "workspaces": [
    "adapters/zapier"
  ]
}
