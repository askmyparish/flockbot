{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "src/**",
      "adapters/zapier/src/**",
      "adapters/zapier/*.json",
      "adapters/mcp/src/**",
      "adapters/mcp/*.json",
      "test/**",
      "scripts/**",
      "*.json",
      "plugins/**/.codex-plugin/*.json",
      "plugins/**/.mcp.json",
      "vitest.config.ts",
      "!package-lock.json",
      ".changeset/*.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
